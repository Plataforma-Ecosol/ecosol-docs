// C4 — Nível 1 (Contexto do sistema) — Plataforma Ecosol
// Gerar: dot -Tpng -Gdpi=200 c4-nivel1-contexto.dot -o c4-nivel1-contexto.png
digraph C4_Contexto {
  graph [rankdir=TB, fontname="Arial", nodesep=0.9, ranksep=1.0, pad=0.3, bgcolor="white",
];
  node  [fontname="Arial", shape=box, style="rounded,filled", fontcolor="white", penwidth=0, margin="0.25,0.15"];
  edge  [fontname="Arial", fontsize=10, color="#555555", fontcolor="#333333", arrowsize=0.8];

  publico [fillcolor="#08427B", label=<<b>Público geral</b><br/><font point-size="9">[Pessoa]</font><br/><br/><font point-size="10">Consumidores, coletivos e interessados<br/>na Economia Solidária. Consultam<br/>coletivos, agenda e mapa, sem login.</font>>];
  equipe  [fillcolor="#08427B", label=<<b>Equipe da Casa Paul Singer</b><br/><font point-size="9">[Pessoa — Administrador]</font><br/><br/><font point-size="10">Equipe do Centro Público de Economia<br/>Solidária. Cadastra e mantém coletivos,<br/>pessoas, eventos e pontos de interesse.</font>>];

  sistema [fillcolor="#1168BD", fontsize=15, margin="0.4,0.3", label=<<b>Plataforma Ecosol</b><br/><font point-size="9">[Sistema de software]</font><br/><br/><font point-size="10">Divulga os coletivos da Economia Solidária<br/>de Niterói (perfis, agenda de eventos e mapa)<br/>e organiza o cadastro da rede, protegendo<br/>os dados pessoais conforme a LGPD.</font>>];

  osm  [fillcolor="#999999", label=<<b>OpenStreetMap</b><br/><font point-size="9">[Sistema externo]</font><br/><br/><font point-size="10">Fornece as imagens (tiles)<br/>do mapa base.</font>>];
  busc [fillcolor="#999999", label=<<b>Buscadores e redes sociais</b><br/><font point-size="9">[Sistemas externos]</font><br/><br/><font point-size="10">Indexam as páginas públicas e geram<br/>a prévia de links compartilhados<br/>(ex.: Google, WhatsApp).</font>>];

  {rank=same; publico; equipe;}
  {rank=same; osm; busc;}

  publico -> sistema [label="  Consulta coletivos,\n  eventos e mapa\n  [HTTPS]"];
  equipe  -> sistema [label="  Cadastra e administra\n  os dados\n  [HTTPS, com login]"];
  sistema -> osm     [label="  Carrega o mapa base\n  [HTTPS]"];
  // desenhada de sistema para busc só para o layout; a seta aponta para o sistema (dir=back)
  sistema -> busc    [label="  Indexam páginas e\n  leem metadados\n  [HTTPS]", dir=back];
}
